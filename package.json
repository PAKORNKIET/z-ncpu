{
  "name": "z-ncpu",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Z-NCPU (Zero-NandCPU) — สร้าง CPU จากเกต NAND",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @z-ncpu/web dev",
    "build": "pnpm --filter @z-ncpu/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && tsc -p tests && tsc -p e2e",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "desktop:dev": "pnpm --filter @z-ncpu/desktop tauri dev",
    "desktop:build": "pnpm --filter @z-ncpu/desktop tauri build",
    "e2e": "pnpm build && playwright test",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@z-ncpu/engine": "workspace:*",
    "@z-ncpu/isa": "workspace:*",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "author": "Pakornkiet Puanpanwong"
}
