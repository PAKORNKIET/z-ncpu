        "tick": 1,
        "expect": {
          "a": 0,
          "b": 0,
          "c": 0,
          "d": 0,
          "x": 0,
          "y": 0
        }
      },
      {
        "set": {
          "reset": 0,
          "in": 11
        },
        "tick": 1,
        "expect": {
          "a": 11,
          "b": 0,
          "x": 11,
          "y": 0
        }
      },
      {
        "set": {
          "rd": 1,
          "in": 22
        },
        "tick": 1,
        "expect": {
          "a": 11,
          "b": 22,
          "x": 22
        }
      },
      {
        "set": {
          "rd": 2,
          "in": 33
        },
        "tick": 1,
        "expect": {
          "c": 33,
          "x": 33
        }
      },
      {
        "set": {
          "rd": 3,
          "in": 44
        },
        "tick": 1,
        "expect": {
          "a": 11,
          "b": 22,
          "c": 33,
          "d": 44,
          "x": 44
        }
      },
      {
        "set": {
          "write": 0,
          "in": 200,
          "rd": 0,
          "rs": 3
        },
        "tick": 2,
        "expect": {
          "a": 11,
          "d": 44,
          "x": 11,
          "y": 44
        }
      },
      {
        "set": {
          "rs": 2
        },
        "expect": {
          "y": 33
        }
      },
      {
        "set": {
          "rd": 2,
          "rs": 2,
          "write": 1,
          "in": 255
        },
        "tick": 1,
        "expect": {
          "c": 255,
          "x": 255,
          "y": 255,
          "a": 11,
          "b": 22,
          "d": 44
        }
      },
      {
        "set": {
          "rd": 1,
          "rs": 0,
          "in": 7
        },
        "tick": 1,
        "expect": {
          "b": 7,
          "x": 7,
          "y": 11
        }
      },
      {
        "set": {
          "write": 0,
          "reset": 1
        },
        "tick": 1,
        "expect": {
          "a": 0,
          "b": 0,
          "c": 0,
          "d": 0
        }
      },
      {
        "set": {
          "reset": 0,
          "write": 1,
          "rd": 3,
          "in": 128
        },
        "tick": 1,
        "expect": {
          "a": 0,
          "d": 128,
          "x": 128
        }
      }
    ]
  },
