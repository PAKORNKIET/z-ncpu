{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z-NCPU",
  "version": "0.1.0",
  "identifier": "io.github.pakornkiet.zncpu",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @z-ncpu/web dev",
    "beforeBuildCommand": "pnpm --filter @z-ncpu/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Z-NCPU — สร้าง CPU จากเกต NAND",
        "width": 1366,
        "height": 860,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Thai",
          "English"
        ],
        "customLanguageFiles": {
          "Thai": "installer/Thai.nsh"
        },
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "Pakornkiet Puanpanwong",
    "copyright": "© 2026 Pakornkiet Puanpanwong · MIT License",
    "category": "Education",
    "shortDescription": "สร้าง CPU จากเกต NAND",
    "longDescription": "Z-NCPU (Zero-NandCPU): เกมสร้าง CPU 8 บิตจากเกต NAND ตั้งแต่ศูนย์ แล้วเขียนโปรแกรม assembly ให้ CPU ที่ต่อเองรันได้จริง",
    "licenseFile": "../../../LICENSE"
  }
}
